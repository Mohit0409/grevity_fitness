# Application
GRAVITY_ENV=development
GRAVITY_HOST=127.0.0.1
GRAVITY_PORT=8787
APP_BASE_URL=http://127.0.0.1:8787
GRAVITY_RUNTIME_DIR=.gravity
GRAVITY_DATA_DIR=.gravity/data
GRAVITY_LOG_DIR=.gravity/logs
GRAVITY_BACKUP_DIR=.gravity/backups
GRAVITY_LOG_LEVEL=INFO
GRAVITY_TRUST_PROXY=false
GRAVITY_TRUSTED_PROXY_CIDRS=
SECRET_KEY=
SESSION_IDLE_SECONDS=43200
SESSION_ABSOLUTE_SECONDS=2592000

# Firebase customer authentication (target project must be verified)
FIREBASE_PROJECT_ID=gravity-authe
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_APP_ID=
FIREBASE_SERVICE_ACCOUNT_PATH=

# Razorpay (optional: leave test mode + all credentials blank to keep checkout disabled)
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Notification providers
# SMS/WhatsApp stay fail-closed until a concrete provider sender is selected; never commit real credentials.
WHATSAPP_PROVIDER=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
SMS_PROVIDER=
SMS_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=

# Verified business details (do not publish placeholders as facts)
OWNER_PHONE=
OWNER_WHATSAPP=
OWNER_EMAIL=
BUSINESS_NAME=Gravity Fitness
BUSINESS_ADDRESS=
BUSINESS_GSTIN=
TAX_INVOICE_ENABLED=false
BUSINESS_INSTAGRAM=https://www.instagram.com/gravity_fitness_nmh/

# Analytics
GOOGLE_ANALYTICS_ID=
META_PIXEL_ID=
