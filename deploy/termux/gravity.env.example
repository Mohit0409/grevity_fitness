# Copy to ~/.config/gravity/gravity.env and chmod 600.
# This file is intentionally outside the Git checkout after installation.
GRAVITY_ENV=production
GRAVITY_HOST=127.0.0.1
GRAVITY_PORT=8787
APP_BASE_URL=https://gravity.example.com
GRAVITY_RUNTIME_DIR=/data/data/com.termux/files/home/.local/state/gravity
GRAVITY_DATA_DIR=/data/data/com.termux/files/home/.local/share/gravity/data
GRAVITY_LOG_DIR=/data/data/com.termux/files/home/.local/state/gravity/logs
GRAVITY_BACKUP_DIR=/data/data/com.termux/files/home/.local/share/gravity/backups
GRAVITY_PYTHON=/data/data/com.termux/files/home/gravity-fitness/.venv/bin/python
GRAVITY_LOG_LEVEL=INFO
GRAVITY_TRUST_PROXY=true
GRAVITY_TRUSTED_PROXY_CIDRS=127.0.0.1/32
SECRET_KEY=
SESSION_IDLE_SECONDS=43200
SESSION_ABSOLUTE_SECONDS=2592000

# Firebase/backend credentials: use real verified values only.
FIREBASE_PROJECT_ID=
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_APP_ID=
FIREBASE_SERVICE_ACCOUNT_PATH=/data/data/com.termux/files/home/.config/gravity/firebase-service-account.json

# Stable named Cloudflare Tunnel. Token file must be chmod 600.
CLOUDFLARED_TOKEN_FILE=/data/data/com.termux/files/home/.config/gravity/cloudflared-token

# Optional encrypted rclone remote. Example: gravity-crypt:GravityFitness/backups
GRAVITY_BACKUP_REMOTE=
GRAVITY_REQUIRE_OFFDEVICE_BACKUP=true
